{
  "name": "opencode-context-watch",
  "version": "0.1.3",
  "description": "OpenCode plugin to warn when a session's context window usage crosses a configurable threshold",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/FAZuH/opencode-context-watch"
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "plugin",
    "context-window"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bundle": "bun build src/index.ts --outdir dist",
    "test": "bun test",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@opencode-ai/ai": "^0.0.0-next-16770",
    "@opencode-ai/client": "^0.0.0-next-16770",
    "@opencode-ai/plugin": "^0.0.0-next-16770",
    "@opencode-ai/schema": "^0.0.0-next-16770",
    "@opencode-ai/sdk": "1.18.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  }
}
